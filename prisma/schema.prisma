generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  clients      Client[]
  jobs         GenerationJob[]
  trendingNewsStates UserTrendingNewsState[]
}

model Client {
  id            String   @id @default(cuid())
  name          String
  doctorName    String
  specialty     String[]
  services      String[] @default([])
  clinicName    String
  city          String
  brandType     String
  postsPerMonth Int      @default(15)
  /** How many calendar rows use multi-slide Carousel (0 = none fixed; remainder are Poster). Must be ≤ postsPerMonth. */
  carouselsPerMonth Int @default(0)
  useCarousels  Boolean  @default(false)
  notes         String?
  /** Inserted before hashtags in every generated supportingText (set at client create/edit). */
  supportingTextDefault String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  specialDays   SpecialDay[]
  topicHistory  TopicHistory[]
  jobs          GenerationJob[]
}

model SpecialDay {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  label    String
  date     String
  type     String
}

model TopicHistory {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  month     Int
  year      Int
  topic     String
  style     String
  postType  String
  createdAt DateTime @default(now())
}

model GenerationJob {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  status    String   @default("pending")
  month     Int
  year      Int
  postCount Int
  /** Extra enqueue fields for serverless/cron replay (e.g. extra special days, overrides). */
  payload   Json?
  fileUrl   String?
  errorMsg  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TrendingNewsIngestionState {
  id        String    @id @default("default")
  lastRunAt DateTime?
  lastOkAt  DateTime?
  lastError String?
}

model TrendingNewsItem {
  id              String   @id @default(cuid())
  clusterId       String   @unique
  primaryHeadline String
  summary         String   @default("")
  specialtyTags   String[]
  relevanceScore  Float
  sources         Json
  fetchedAt       DateTime
  createdAt       DateTime @default(now())
  suggestion      NewsPosterSuggestion?
  userStates      UserTrendingNewsState[]
}

model NewsPosterSuggestion {
  id                         String           @id @default(cuid())
  newsItemId                 String           @unique
  newsItem                   TrendingNewsItem @relation(fields: [newsItemId], references: [id], onDelete: Cascade)
  headlines                  String[]
  keyTakeaway                String
  visualDirection            Json
  recommendedSpecialtyTags   String[]
  cta                        String
  complianceStatus           String
  complianceFlags            String[]
  createdAt                  DateTime         @default(now())
}

model UserTrendingNewsState {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  newsItemId String
  newsItem   TrendingNewsItem @relation(fields: [newsItemId], references: [id], onDelete: Cascade)
  saved      Boolean          @default(false)
  dismissed  Boolean          @default(false)
  updatedAt  DateTime         @updatedAt

  @@unique([userId, newsItemId])
  @@index([userId])
}
