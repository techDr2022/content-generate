generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  clients      Client[]
  jobs         GenerationJob[]
  reviewSessionsCreated ClientReviewSession[]
  openAiUsageLogs OpenAiUsageLog[]
}

/** Estimated OpenAI poster image spend (for dashboard when billing API is unavailable). */
model OpenAiUsageLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  operation String
  model     String
  size      String?
  quality   String?
  costUsd   Float
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

model Client {
  id            String   @id @default(cuid())
  name          String
  doctorName    String
  specialty     String[]
  services      String[] @default([])
  clinicName    String
  city          String
  brandType     String
  /** Single-image Poster rows per month (0–30). */
  postsPerMonth Int      @default(15)
  /** Carousel rows per month (0–10), stacked on postsPerMonth poster rows (combined ≤ 62). */
  carouselsPerMonth Int @default(0)
  useCarousels  Boolean  @default(false)
  /** Animated (motion) rows per month (0–10), stacked on posters and carousels (combined ≤ 62). */
  animatedPerMonth Int @default(0)
  notes         String?
  /** Instructions for AI when generating calendar copy and posters (not internal team notes). */
  generationNotes String?
  /** Inserted before hashtags in every generated supportingText (set at client create/edit). */
  supportingTextDefault String?
  /** Colors, typography, grid, poster looks, and design guidelines (JSON). */
  brandKit      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  specialDays   SpecialDay[]
  topicHistory  TopicHistory[]
  jobs          GenerationJob[]
  calendars     Calendar[]
  reviewSessions ClientReviewSession[]
}

model SpecialDay {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  label    String
  date     String
  type     String
}

model TopicHistory {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  month     Int
  year      Int
  topic     String
  style     String
  postType  String
  createdAt DateTime @default(now())
}

model GenerationJob {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  status    String   @default("pending")
  month     Int
  year      Int
  postCount Int
  /** Poster-type rows in the completed calendar (set when status becomes done). */
  posterCount Int?
  /** Extra enqueue fields for serverless/cron replay (e.g. extra special days, overrides). */
  payload   Json?
  fileUrl   String?
  errorMsg  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  calendar  Calendar?
}

model Calendar {
  id        String   @id
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  month     Int
  year      Int
  job       GenerationJob @relation(fields: [id], references: [id], onDelete: Cascade)
  posts     Post[]
  reviewSessions ClientReviewSession[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

model Post {
  id              String   @id @default(cuid())
  calendarId      String
  calendar        Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  rowIndex        Int
  date            String
  code            String
  department      String
  postType        String
  style           String
  textInImage     String   @default("")
  caption         String
  hashtags        String   @default("")
  specialDay      String?
  topic           String   @default("")
  isAIAdded       Boolean  @default(false)
  posterObjectKey String?
  feedback        PostFeedback[]
  logEntries      ReviewSessionLog[] @relation("LogPost")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([calendarId, rowIndex])
  @@index([calendarId])
}

enum ReviewSessionStatus {
  PENDING
  OPENED
  IN_REVIEW
  SUBMITTED
  EXPIRED
}

enum PostFeedbackStatus {
  PENDING
  APPROVED
  APPROVED_WITH_EDITS
  REJECTED
}

model ClientReviewSession {
  id              String    @id @default(cuid())
  clientId        String
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  calendarId      String
  calendar        Calendar  @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdBy       User      @relation(fields: [createdByUserId], references: [id])

  accessToken     String    @unique
  pin             String?
  email           String?
  expiresAt       DateTime
  lastAccessedAt  DateTime?

  status          ReviewSessionStatus @default(PENDING)
  submittedAt     DateTime?
  internalNote    String?

  postFeedbacks   PostFeedback[]
  sessionLogs     ReviewSessionLog[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([clientId, calendarId])
  @@index([accessToken])
}

model PostFeedback {
  id               String    @id @default(cuid())
  sessionId        String
  session          ClientReviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  postId           String
  post             Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  status           PostFeedbackStatus @default(PENDING)
  editedCaption    String?
  editedHashtags   String?
  rejectionReason  String?
  clientNote       String?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([sessionId, postId])
}

model ReviewSessionLog {
  id          String   @id @default(cuid())
  sessionId   String
  session     ClientReviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  event       String
  postId      String?
  post        Post?    @relation("LogPost", fields: [postId], references: [id], onDelete: SetNull)
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([sessionId])
}
