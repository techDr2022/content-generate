# =============================================================================
# Next.js (this file → copy to `.env.local` for local development)
# =============================================================================
# Never commit real secrets. Client-exposed vars MUST use the NEXT_PUBLIC_ prefix.

# -----------------------------------------------------------------------------
# Database (Neon pooled URL recommended)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.neon.tech/neondb?sslmode=require

# -----------------------------------------------------------------------------
# Redis (BullMQ queue + worker — required for calendar generation)
# Local dev: set REDIS_URL, then run `npm run dev:all` (Next + worker) or two terminals:
# `npm run dev` and `npm run worker`. Without the worker, jobs stay "Queued" and never finish.
# Production: run the same worker process beside your Node server (or a dedicated worker dyno).
# -----------------------------------------------------------------------------
REDIS_URL=

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Seed password for contact@techdr.in and support@techdr.in (`npm run db:seed`)
TECHDR_PASSWORD=techDr

# -----------------------------------------------------------------------------
# Canonical site URL (metadata, Open Graph). Also used for local workbook download links.
# On Vercel you can leave unset — VERCEL_URL is used at runtime.
# -----------------------------------------------------------------------------
PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Optional: if the browser calls a different API origin (split deploy).
# Leave unset for same-origin /api on Vercel.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=

# -----------------------------------------------------------------------------
# AI providers (server-only — never NEXT_PUBLIC_)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Default in code: claude-sonnet-4-6; override with ANTHROPIC_MODEL if needed
ANTHROPIC_MODEL=
ANTHROPIC_MAX_TOKENS=
ANTHROPIC_TIMEOUT_MS=

OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=dall-e-3
# OPENAI_IMAGE_SIZE=1024x1024

# Optional: NewsAPI key for additional health headlines (Trending Healthcare News ingestion)
NEWS_API_KEY=

# -----------------------------------------------------------------------------
# Object storage — STORAGE_TYPE=LOCAL | S3
# -----------------------------------------------------------------------------
STORAGE_TYPE=LOCAL
LOCAL_STORAGE_PATH=./uploads
# Strongly recommended when `npm run worker` runs beside `next dev`: absolute path so both
# processes always read/write the same folder (relative paths depend on process.cwd()).
# LOCAL_STORAGE_ABSOLUTE_PATH=/Users/you/projects/content-generate/uploads

# R2 / S3 (when STORAGE_TYPE=S3)
# S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# R2_ACCOUNT_ID=
# AWS_BUCKET_NAME=content-gen
# AWS_REGION=auto
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
