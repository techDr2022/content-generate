{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/clients/[id]",
      "regex": "^/api/clients/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/clients/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/clients/[id]/history",
      "regex": "^/api/clients/([^/]+?)/history(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/clients/(?<nxtPid>[^/]+?)/history(?:/)?$"
    },
    {
      "page": "/api/jobs/[id]",
