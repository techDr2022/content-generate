      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/jobs/(?<nxtPid>[^/]+?)/cancel(?:/)?$"
    },
    {
      "page": "/api/jobs/[id]/download",
      "regex": "^/api/jobs/([^/]+?)/download(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/jobs/(?<nxtPid>[^/]+?)/download(?:/)?$"
    },
    {
      "page": "/api/jobs/[id]/preview",
      "regex": "^/api/jobs/([^/]+?)/preview(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/jobs/(?<nxtPid>[^/]+?)/preview(?:/)?$"
    },
    {
      "page": "/api/jobs/[id]/progress",
      "regex": "^/api/jobs/([^/]+?)/progress(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/jobs/(?<nxtPid>[^/]+?)/progress(?:/)?$"
    },
    {
      "page": "/api/jobs/[id]/regenerate",
      "regex": "^/api/jobs/([^/]+?)/regenerate(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/jobs/(?<nxtPid>[^/]+?)/regenerate(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/bulk-export",
      "regex": "^/bulk\\-export(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/bulk\\-export(?:/)?$"
    },
    {
      "page": "/clients",
      "regex": "^/clients(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/clients(?:/)?$"
    },
    {
      "page": "/generator",
      "regex": "^/generator(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/generator(?:/)?$"
    },
    {
      "page": "/jobs",
      "regex": "^/jobs(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/jobs(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/poster-images",
      "regex": "^/poster\\-images(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/poster\\-images(?:/)?$"
    },
    {
      "page": "/settings",
      "regex": "^/settings(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/settings(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
