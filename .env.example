# Copy to `.env` at the repo root (recommended) or `server/.env`. Both are loaded; server file overrides root.

# Server
PORT=4000
# Neon: use the pooler URL from the dashboard for server apps. Prisma + PgBouncer:
# postgresql://USER:PASS@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.neon.tech/neondb?sslmode=require


JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# TechDr login — both seeded users share this password until someone changes it in Settings.
# After editing, run from repo root: npm run db:seed  (updates bcrypt hashes in the database)
TECHDR_PASSWORD=techDr

# Optional: public URL of this API (used in LOCAL storage download links)
PUBLIC_APP_URL=https://your-api.example.com

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Default in code is Claude Haiku 4.5 (lower cost); override if needed (e.g. claude-sonnet-4-5)
ANTHROPIC_MODEL=claude-haiku-4-5

# OpenAI (optional) — poster images from “Text in image” via Images API (default dall-e-3)
OPENAI_API_KEY=
# Optional overrides: OPENAI_IMAGE_MODEL=dall-e-3  OPENAI_IMAGE_SIZE=1024x1024

# -----------------------------------------------------------------------------
# Object storage — STORAGE_TYPE=LOCAL | S3
# The AWS SDK always reads AWS_* env vars (even for Cloudflare R2 — put R2
# token “Access Key ID / Secret” in those two variables).
# -----------------------------------------------------------------------------
STORAGE_TYPE=S3
LOCAL_STORAGE_PATH=./uploads

# ===== Option A — Cloudflare R2 (S3-compatible API) =====
# Account ID: ebb3590f9b5494439c819d69152eb760
# S3 API URL (no bucket in the path):
S3_ENDPOINT=https://ebb3590f9b5494439c819d69152eb760.r2.cloudflarestorage.com
# Or omit S3_ENDPOINT and use: R2_ACCOUNT_ID=ebb3590f9b5494439c819d69152eb760
AWS_BUCKET_NAME=content-gen
AWS_REGION=auto
AWS_ACCESS_KEY_ID=your_r2_access_key_id
AWS_SECRET_ACCESS_KEY=your_r2_secret_access_key
S3_FORCE_PATH_STYLE=true

# ===== Option B — Amazon AWS S3 (real AWS) =====
# Comment out Option A (S3_ENDPOINT, R2 lines) and use instead, for example:
# STORAGE_TYPE=S3
# AWS_BUCKET_NAME=my-app-bucket
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIAxxxxxxxx
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# S3_FORCE_PATH_STYLE=false
# (Leave S3_ENDPOINT and R2_ACCOUNT_ID unset — default AWS endpoints are used.)

# Client (Vite): omit entirely for local dev — browser uses :5173, proxy forwards /api → PORT (4000).
# When the UI and API share one origin (full-stack Vercel deploy), omit VITE_API_URL so the browser calls /api on the same host.
# If you split UI and API across domains, set the API origin (https only, no trailing slash). Rebuild the client after changing.
# Example (split deploy): VITE_API_URL=https://your-api.onrender.com
# VITE_API_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# Vercel (monolith: static UI + /api serverless + Cron workers)
# -----------------------------------------------------------------------------
# VERCEL=1 is injected by Vercel — calendar jobs use DB + Cron (/api/cron/run-worker) instead of a long-running BullMQ worker.
# Protect cron in production (Authorization: Bearer <secret>):
# CRON_SECRET=generate-a-long-random-string
# Optional: test cron-style jobs locally without Redis worker:
# JOB_RUNNER=cron
