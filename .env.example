# =============================================================================
# Backend (.env at repo root for local dev; on Railway use the dashboard "Variables")
# Railway: default `railway.json` runs Next + BullMQ worker (`start:web-and-worker`) so generation
# jobs process on one service. Alternatively use `npm start` here and add a second service with
# Start `npm run worker`, disable HTTP healthcheck (worker does not listen on PORT). Same DATABASE_URL / REDIS_URL / keys on both.
# CLI (no Homebrew needed): from repo root run `npm run railway -- login` (uses devDependency @railway/cli).
# =============================================================================
# Loader: server/src/loadEnv.ts reads .env at repo root AND server/.env (server wins).

# -----------------------------------------------------------------------------
# Express
# -----------------------------------------------------------------------------
PORT=4000

# -----------------------------------------------------------------------------
# CORS — comma-separated list of browser origins allowed to call the API.
# In production: set this to the frontend's Vercel URL (no trailing slash).
# Local dev: leave unset (Vite dev server already proxies /api → http://localhost:4000).
# Examples:
#   FRONTEND_URL=https://my-app.vercel.app
#   FRONTEND_URL=https://my-app.vercel.app,https://app.mycompany.com
# -----------------------------------------------------------------------------
FRONTEND_URL=

# -----------------------------------------------------------------------------
# PostgreSQL (Neon recommended — use the pooled connection URL)
# postgresql://USER:PASS@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true
# -----------------------------------------------------------------------------
# Neon: use the pooled URL for the app (often includes `-pooler` in the host).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Same database, *direct* endpoint (no `-pooler`) — required for `prisma migrate` to avoid P1002 lock timeouts.
# Omit locally if DATABASE_URL is already direct (e.g. local Postgres).
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# -----------------------------------------------------------------------------
# Redis — BullMQ queue + worker (required for calendar generation).
# Upstash: open your database → use the "Redis" connection string (redis:// or
# rediss://), NOT the REST URL. Paste the same REDIS_URL wherever Next runs and
# wherever `npm run worker` runs. Any other host (TLS redis://) is fine too.
# -----------------------------------------------------------------------------
REDIS_URL=

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Client content review portal (token + cookie auth — separate from JWT_SECRET)
# -----------------------------------------------------------------------------
REVIEW_TOKEN_SECRET=replace_with_at_least_32_random_chars_hex_or_phrase
REVIEW_SESSION_SECRET=replace_with_a_different_32plus_char_secret
# Public base URL used in client invite emails (falls back to PUBLIC_APP_URL)
REVIEW_BASE_URL=
# Shown in invite email footer
AGENCY_DISPLAY_NAME=Your agency name

# Seed password for contact@techdr.in and support@techdr.in.
# After editing, run from repo root: npm run db:seed
TECHDR_PASSWORD=techDr

# -----------------------------------------------------------------------------
# Public URL of THIS API (used in LOCAL storage download links)
# Set this to your Railway public domain in production, e.g.:
#   PUBLIC_APP_URL=https://content-gen-api.up.railway.app
# -----------------------------------------------------------------------------
PUBLIC_APP_URL=

# -----------------------------------------------------------------------------
# AI providers
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Default in code is Claude Sonnet 4.6; override for cost/speed (e.g. claude-haiku-4-5)
ANTHROPIC_MODEL=claude-sonnet-4-6
# Max OUTPUT tokens for calendar JSON (large months + long captions). Default in code is 64000 if unset.
# If you see "Unterminated string" / truncated JSON, set ANTHROPIC_MAX_TOKENS=128000 (code caps at 128k).
# If the API returns an error about max_tokens, lower this to your model's limit (e.g. 8192 or 16384).
# ANTHROPIC_MAX_TOKENS=64000
# ANTHROPIC_TIMEOUT_MS=360000
# Second Claude pass after generation to review/fix every calendar cell (default on). Set to false to skip.
# CALENDAR_CONTENT_REVIEW=false

# OpenAI (poster image generation; optional but recommended)
OPENAI_API_KEY=
# Dashboard: show remaining prepaid credits (tries OpenAI billing API; fallback below)
# OPENAI_ADMIN_API_KEY=   # optional — same key often works for credit_grants
# OPENAI_CREDIT_BALANCE_USD=3.03   # manual balance if live sync fails (minus app-tracked image spend)
# OPENAI_AUTO_RECHARGE_USD=10      # display only — match your OpenAI auto-recharge amount
# Optional overrides:
# OPENAI_IMAGE_MODEL=dall-e-3
# OPENAI_IMAGE_SIZE=1024x1024
# When you upload a logo or doctor photo, the API uses images.edit with a GPT image model.
# If OPENAI_IMAGE_MODEL is not a gpt-image-* id, set this (default in code: gpt-image-1.5):
# OPENAI_IMAGE_EDIT_MODEL=gpt-image-1.5

# -----------------------------------------------------------------------------
# Object storage — STORAGE_TYPE=LOCAL | S3
# LOCAL: files saved under LOCAL_STORAGE_PATH. NOTE: ephemeral on Railway —
# any file written disappears on the next deploy. Use S3/R2 in production.
# -----------------------------------------------------------------------------
STORAGE_TYPE=S3
LOCAL_STORAGE_PATH=./uploads

# ===== Option A — Cloudflare R2 (S3-compatible) =====
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
AWS_BUCKET_NAME=content-gen
AWS_REGION=auto
AWS_ACCESS_KEY_ID=your_r2_access_key_id
AWS_SECRET_ACCESS_KEY=your_r2_secret_access_key
S3_FORCE_PATH_STYLE=true

# ===== Option B — AWS S3 =====
# Comment out the R2 lines above and use:
# AWS_BUCKET_NAME=my-app-bucket
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIAxxxxxxxx
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# S3_FORCE_PATH_STYLE=false
# (leave S3_ENDPOINT unset)

# =============================================================================
# Frontend (Vite) — these belong in client/.env.local for local dev and in
# Vercel → Project → Settings → Environment Variables for production.
# Vite only inlines variables that begin with VITE_ into the browser bundle.
# =============================================================================
# Local dev: leave unset; the Vite dev server proxies /api → http://localhost:4000.
# Production (split deploy): set to your Railway backend URL, no trailing slash:
#   VITE_API_URL=https://content-gen-api.up.railway.app
VITE_API_URL=
